# Where to post when a new ModernUO release appears. Any endpoint that accepts a
# Slack-shaped JSON payload works — Mattermost, Slack, Discord with /slack.
WEBHOOK_URL=https://example.invalid/hooks/replace-me

# The version you actually built. The watcher compares upstream against this and
# stays quiet while they match, so it reports being BEHIND rather than merely
# announcing that a release happened.
PINNED_VERSION=0.15.6.119

# Seconds between checks. Daily is plenty for a release feed.
POLL_SECONDS=86400
REPO=modernuo/ModernUO
