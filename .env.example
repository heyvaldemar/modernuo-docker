# Copy to .env and pin a released version. Check the tag you want at
# https://github.com/modernuo/ModernUO/releases
MODERNUO_REF=0.15.6.178

# How long the shard may go without writing its world to disk before the health
# check calls it unhealthy, in minutes. ModernUO's shipped autosave interval is
# five minutes; twenty is four missed saves. Shorten it if you shortened
# autosave.saveDelay in config/modernuo.json. Default: 20.
# MODERNUO_SAVE_MAX_AGE=20

# The init service that keeps the save directory off the mount point. Pinned by
# digest in the compose file; set this to run a different alpine.
# MODERNUO_INIT_IMAGE_VERSION=3.22
